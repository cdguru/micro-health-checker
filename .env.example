# Database being monitored. Use a dedicated, least-privilege login.
POSTGRES_PROD_DSN=postgres://healthcheck:change-me@postgres.example:5432/app?sslmode=require

# Only required when storage.type is postgres.
MHC_DATABASE_URL=postgres://micro_health_checker:change-me@storage-postgres:5432/micro_health_checker?sslmode=disable

# debug, info, warn or error
MHC_LOG_LEVEL=info
